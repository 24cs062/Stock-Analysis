# ============================================
# EquiMind .gitignore
# ============================================

# ----- Java / Spring Boot -----
*.class
*.jar
*.war
*.ear
*.log
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ----- Maven -----
.mvn/
mvnw
mvnw.cmd

# ----- Gradle (if used) -----
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# ----- IntelliJ IDEA -----
.idea/
*.iws
*.iml
*.ipr
out/

# ----- Eclipse -----
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/

# ----- VS Code -----
.vscode/

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
eggs/
*.whl
pip-log.txt
pip-delete-this-directory.txt

# Python virtual environments
venv/
env/
.env/
.venv/

# Jupyter Notebooks
.ipynb_checkpoints/

# ----- Node.js / React -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js

# React build output
frontend/build/
frontend/dist/

# ----- Environment / Secrets -----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# ----- Docker -----
docker-compose.override.yml

# ----- PostgreSQL data -----
pgdata/
postgres-data/

# ----- LM Studio models (large files) -----
models/
*.gguf
*.bin

# ----- OS files -----
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# ----- Logs -----
logs/
*.log

# ----- Coverage / Testing -----
coverage/
htmlcov/
.pytest_cache/
.tox/
.nox/
