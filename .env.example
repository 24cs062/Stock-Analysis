# ============================================
# EquiMind Environment Configuration
# Copy this file to .env and update values
# ============================================

# PostgreSQL
DB_PASSWORD=postgres

# JWT Authentication (change in production)
JWT_SECRET=equimind-dev-secret-key-change-me

# LM Studio (local AI)
LM_STUDIO_URL=http://localhost:1234

# Data Mode: DEMO (static data) or LIVE_BATCH (fetch from Yahoo)
DATA_MODE=DEMO
